{
	"name": "gcgov/framework-service-gcgov-cron-monitor",
	"type": "framework-service",
	"description": "An internal to Garrett County Government plugin that provides access to \\gcgov\\framework\\services\\cronMonitor to record cron task runs",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"gcgov\\framework\\services\\cronMonitor\\": "src/"
		}
	},
	"require": {
		"php": ">=8.1",
		"guzzlehttp/guzzle": "^7.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.5",
		"jetbrains/phpstorm-attributes": "^1.0",
		"gcgov/framework": "dev-main"
	},
	"repositories": [
		{ "type": "path", "url": "../framework*", "options": { "symlink": true } }
	],
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=512M",
		"test": "phpunit",
		"ci": ["@phpstan", "@test"]
	}
}
